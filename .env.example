# Copie para ".env.local" (arquivo ignorado pelo Git) se for testar no computador com "vercel dev".
# Na Vercel, cadastre estes nomes em Settings > Environment Variables.
# NUNCA coloque valores reais neste arquivo de exemplo.

# Chave PÚBLICA do Clerk (começa com pk_)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Chave SECRETA do Clerk (começa com sk_) — só no servidor
CLERK_SECRET_KEY=

# Endereço de conexão do Neon (a integração da Vercel cria esta variável sozinha)
DATABASE_URL=

# Token do Vercel Blob (criado sozinho ao conectar um Blob store ao projeto)
BLOB_READ_WRITE_TOKEN=

# Opcional: endereços permitidos para o login (separados por vírgula), ex.: https://seu-site.vercel.app
CLERK_AUTHORIZED_PARTIES=
